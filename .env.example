# Set these in your shell (export ...) or a local .env. Never commit real values.

# From the deployment output: `projectEndpoint`
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# Optional. Defaults to gpt-5-mini, the name infra/main.bicep deploys.
MODEL_NAME=gpt-5-mini

# Module 3 only: the model AgentOps uses to score answers (LLM-as-judge).
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
